#1
# Sisestatakse 15 arvu.
# Määrata, mitu neist on täisarvud.
for i in range(15):
    try:
        arv=float(input(f"{i+1}. arv: "))
        if arv.is_integer():
            print(f"{arv} on täisarv.")
        else:
            print(f"{arv} ei ole täisarv.")
    except ValueError:
        print("Palun sisestage arv.")
    i += 1

# while true ja break
i = 0
while True:
    try:
        arv = float(input(f"{i + 1}. arv: "))
        if arv.is_integer():
            print(f"{arv} on täisarv.")
        else:
            print(f"{arv} ei ole täisarv.")
        i += 1
        if i==15:
            break
    except ValueError:
        print("Palun sisestage arv.")

#2
# Küsi kasutajalt arv A ja leia kõigi naturaalarvude summa vahemikus 1 kuni A.
try:
    A = int(input("Sisesta arv a: "))
    summa = 0
    for i in range(1, A + 1):
        summa += i
    print(f"Summa vahemikus 1 kuni {A} on {summa}.")
except ValueError:
    print("Palun sisestage täisarv.")

#3 Sisestatakse 8 arvu.
# Leida nende korrutis (ainult positiivsete arvude puhul).
korrutis=1
for i in range(8):
    try:
        arv = float(input(f"{i + 1}. arv: "))
        if arv > 0:
            korrutis *= arv
    except ValueError:
        print("Palun sisestage arv.")
#while true ja break
while True:
    try:
        arv = float(input(f"{i + 1}. arv: "))
        if arv > 0:
            korrutis *= arv
            print(f"{arv} on täisarv.")
        else:
            print(f"{arv} ei ole täisarv.")
        i += 1
        if i==8:
            break
    except ValueError:
        print("Palun sisestage arv.")

#4. Koosta programm, mis väljastab ekraanile arvude ruudud vahemikus 10 kuni 20.
#arvude ruudud vahemikus 10 kuni 20. 10^2, 11^2, 12^2, ..., 20^2
#for
for i in range (10, 21):
    print(f"{i}^2 = {i**2}")
#while
i = 10
while i >= 20:
    print(f"{i}^2 = {i**2}")
    i += 1
# 5. Koosta programm, mis arvutab ainult negatiivsete arvude summa N sisestatud arvu seast.
# N väärtus sisestatakse klaviatuurilt.
N = int(input("Sisesta arvude hulk N: "))
summa = 0
for i in range(N):
    arv = float(input(f"Sisesta {i +1}. arv:"))
    if arv < 0:
        i += 1
print(f"Negatiivne arvude summa on {summa}.")

#6Klaviatuurilt sisestatakse N arvu.
# Koosta programm, mis määrab sisestatud arvude seast:negatiivsete arvude arvu,positiivsete arvude arvu,nullide arvu.
# (N väärtus sisestatakse klaviatuurilt.)
try:
    N = int(input("sisesta arvude kogus N: "))









while True:
    print("\nTee valik: ")
    print("1. while-tsükkel")
    print("2. while True ja break")
    print("3. for-tsükkel")
    print("4. summa ja keskmine")
    print("5. loendamine ja suurus")
    print("0. välju")

    valik = input("Vali tegevus: ")
    if valik == "0":
        break
    elif valik =="1":
#1. while-tsükkel
        x = 0
        while x < 30:
            if x % 2 == 0:
                print(x, end=" ")
            x += 1
    elif valik == "2":

#2. while true ja break
        x = 0
        while True:
            if x % 2 == 1:
                print(x, end=" ")
            if x == 30:
                break
            x += 1
    elif valik == "3":

#3. for tsükkel
        for i in range(0, 31, 2):
            print(i, end=" ")
    elif valik == "4":
#4. summa ja keskmine
        N = int(input("N: "))
        summa = 0
        i = 1
        while i <= N:
            summa = summa + i
            i = i + 1
        print("Summa:", summa)
        print("Keskmine:", summa / N)
    
    elif valik == "5":
        #5 loendamine ja suurus
        kogus = 0
        suurim = None
        for i in range(5):
            arv = float(input(f"{i + 1}. arv: "))
            if arv > 0:
                kogus += 1
            if suurim is None or arv > suurim:
                suurim = arv
        print("Positiivseid arve:", kogus)
        print("Suurim arv:", suurim)
    else:
        print("Vale valik")
